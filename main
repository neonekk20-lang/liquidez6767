TabContainer.BackgroundColor3 = colors.background
TabContainer.BorderSizePixel = 0
TabContainer.Parent = MainFrame

-- Tab Buttons
local tabs = {"Combat", "Visuals", "Movement", "Settings", "Discord"}
local tabButtons = {}

for i, tabName in ipairs(tabs) do
    local button = Instance.new("TextButton")
    button.Name = tabName .. "Tab"
    button.Size = UDim2.new(0, 120, 1, 0)
    button.Position = UDim2.new(0, (i-1) * 120, 0, 0)
    button.BackgroundColor3 = i == 1 and colors.tabActive or colors.tabInactive
    button.Text = tabName
    button.TextColor3 = colors.text
    button.TextSize = 14
    button.Font = Enum.Font.GothamSemibold
    button.BorderSizePixel = 0
    button.Parent = TabContainer
    tabButtons[tabName] = button
    
    button.MouseEnter:Connect(function()
        if currentTab ~= tabName then
            button.BackgroundColor3 = colors.tabActive
        end
    end)
    
    button.MouseLeave:Connect(function()
        if currentTab ~= tabName then
            button.BackgroundColor3 = colors.tabInactive
        end
    end)
    
    button.MouseButton1Click:Connect(function()
        for _, btn in pairs(tabButtons) do
            btn.BackgroundColor3 = colors.tabInactive
        end
        button.BackgroundColor3 = colors.tabActive
        currentTab = tabName
        updateTabVisibility()
    end)
end

