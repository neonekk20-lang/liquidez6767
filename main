    local btn = Instance.new("TextButton", TabContainer)
    btn.Size = UDim2.new(0, 108, 1, -6)
    btn.Position = UDim2.new(0, 8 + (i-1) * 116, 0, 3)
    btn.BackgroundColor3 = i == 1 and colors.tabActive or colors.tabInactive
    btn.Text = tabName
    btn.TextColor3 = i == 1 and colors.accent or colors.subtext
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    tabButtons[tabName] = btn

    btn.MouseEnter:Connect(function()
        if currentTab ~= tabName then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = colors.tabActive}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if currentTab ~= tabName then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = colors.tabInactive}):Play()
        end
    end)
    btn.MouseButton1Click:Connect(function()
        for name, b in pairs(tabButtons) do
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = colors.tabInactive}):Play()
            b.TextColor3 = colors.subtext
        end
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = colors.tabActive}):Play()
        btn.TextColor3 = colors.accent
        currentTab = tabName
        updateTabVisibility()
    end)
end

