-- ==================== GLOBAL FUNCTIONS ====================

function updateTabVisibility()
    for tabName, container in pairs(tabContents) do
        container.Visible = (tabName == currentTab)
    end
end

function notify(message, duration)
    local notif = Instance.new("Frame", ScreenGui)
    notif.Size = UDim2.new(0, 300, 0, 46)
    notif.Position = UDim2.new(0.5, -150, 0, -60)
    notif.BackgroundColor3 = colors.topbar
    notif.BorderSizePixel = 0
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = colors.accent
    stroke.Thickness = 1

    local text = Instance.new("TextLabel", notif)
    text.Size = UDim2.new(1, -16, 1, 0)
    text.Position = UDim2.new(0, 8, 0, 0)
    text.BackgroundTransparency = 1
    text.Text = message
    text.TextColor3 = colors.text
    text.TextWrapped = true
    text.Font = Enum.Font.GothamSemibold
    text.TextSize = 13

    TweenService:Create(notif, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -150, 0, 10)
    }):Play()

    task.delay(duration or 2.5, function()
        TweenService:Create(notif, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -150, 0, -60)
        }):Play()
        task.wait(0.3)
        if notif and notif.Parent then notif:Destroy() end
    end)
end

-- ==================== DRAG ====================

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ==================== BUTTONS ====================

CloseButton.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

MinimizeButton.MouseButton1Click:Connect(function()
    guiVisible = false
    MainFrame.Visible = false
end)

-- ==================== KEYBINDS ====================

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        guiVisible = not guiVisible
        MainFrame.Visible = guiVisible
    elseif input.KeyCode == Enum.KeyCode.G then
        aimbotEnabled = not aimbotEnabled; updateAimbot()
        notify("Aimbot " .. (aimbotEnabled and "ON ✓" or "OFF ✕"), 1.5)
    elseif input.KeyCode == Enum.KeyCode.H then
        speedEnabled = not speedEnabled; updateSpeed()
        notify("Speed " .. (speedEnabled and "ON ✓" or "OFF ✕"), 1.5)
    elseif input.KeyCode == Enum.KeyCode.J then
        flyEnabled = not flyEnabled; updateFly()
        notify("Fly " .. (flyEnabled and "ON ✓" or "OFF ✕"), 1.5)
    elseif input.KeyCode == Enum.KeyCode.K then
        noclipEnabled = not noclipEnabled; updateNoclip()
        notify("NoClip " .. (noclipEnabled and "ON ✓" or "OFF ✕"), 1.5)
    end
end)

-- ==================== LOOPS ====================

RunService.RenderStepped:Connect(function()
    if espEnabled then updateESP() end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if speedEnabled then updateSpeed() end
    if flyEnabled then updateFly() end
    if jumpEnabled then updateJump() end
    if noclipEnabled then updateNoclip() end
    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            createESPForPlayer(player)
        end
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
end)

