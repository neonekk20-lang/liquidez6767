local function createSection(parent, title)
    local section = Instance.new("Frame", parent)
    section.Size = UDim2.new(1, -4, 0, 28)
    section.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
    section.BackgroundTransparency = 0.82
    section.BorderSizePixel = 0
    Instance.new("UICorner", section).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel", section)
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = "▸  " .. title
    label.TextColor3 = colors.accent
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    return section
end

local function createToggle(parent, name, default, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -4, 0, 38)
    frame.BackgroundColor3 = colors.topbar
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 7)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(42, 42, 55)
    stroke.Thickness = 1

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = colors.text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 13

    local toggleBg = Instance.new("Frame", frame)
    toggleBg.Size = UDim2.new(0, 44, 0, 22)
    toggleBg.Position = UDim2.new(1, -54, 0.5, -11)
    toggleBg.BackgroundColor3 = default and colors.green or colors.red
    toggleBg.BorderSizePixel = 0
    Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", toggleBg)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local toggleState = default

    local clickArea = Instance.new("TextButton", frame)
    clickArea.Size = UDim2.new(1, 0, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""

    clickArea.MouseButton1Click:Connect(function()
        toggleState = not toggleState
        TweenService:Create(toggleBg, TweenInfo.new(0.18), {
            BackgroundColor3 = toggleState and colors.green or colors.red
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = toggleState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        }):Play()
        if callback then callback(toggleState) end
    end)

    return frame
end

local function createSlider(parent, name, min, max, default, suffix, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -4, 0, 58)
    frame.BackgroundColor3 = colors.topbar
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 7)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(42, 42, 55)
    stroke.Thickness = 1

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(0.6, 0, 0, 22)
    label.Position = UDim2.new(0, 12, 0, 6)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = colors.text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 13

    local valueLabel = Instance.new("TextLabel", frame)
    valueLabel.Size = UDim2.new(0.4, -12, 0, 22)
    valueLabel.Position = UDim2.new(0.6, 0, 0, 6)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default) .. (suffix ~= "" and " " .. suffix or "")
    valueLabel.TextColor3 = colors.accent
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 13

    local sliderBg = Instance.new("Frame", frame)
    sliderBg.Size = UDim2.new(1, -24, 0, 5)
    sliderBg.Position = UDim2.new(0, 12, 0, 38)
    sliderBg.BackgroundColor3 = colors.sliderBg
    sliderBg.BorderSizePixel = 0
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

    local pct = math.clamp((default - min) / (max - min), 0, 1)

    local fill = Instance.new("Frame", sliderBg)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = colors.accent
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", sliderBg)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(pct, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local isDragging = false

    local function updateSlider(mouseX)
        local relX = math.clamp((mouseX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local rounded = math.floor((min + relX * (max - min)) * 10 + 0.5) / 10
        fill.Size = UDim2.new(relX, 0, 1, 0)
        knob.Position = UDim2.new(relX, -7, 0.5, -7)
        valueLabel.Text = tostring(rounded) .. (suffix ~= "" and " " .. suffix or "")
        if callback then callback(rounded) end
    end

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = true end
    end)
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            updateSlider(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input.Position.X)
        end
    end)

    return frame
end

local function createDropdown(parent, name, options, default, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -4, 0, 62)
    frame.BackgroundColor3 = colors.topbar
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = false
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 7)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(42, 42, 55)
    stroke.Thickness = 1

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -20, 0, 22)
    label.Position = UDim2.new(0, 12, 0, 6)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = colors.text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 13

    local dropdown = Instance.new("TextButton", frame)
    dropdown.Size = UDim2.new(1, -24, 0, 26)
    dropdown.Position = UDim2.new(0, 12, 0, 30)
    dropdown.BackgroundColor3 = colors.button
    dropdown.Text = "  " .. (default or options[1]) .. "  ▾"
    dropdown.TextColor3 = colors.text
    dropdown.TextSize = 12
    dropdown.Font = Enum.Font.Gotham
    dropdown.BorderSizePixel = 0
    dropdown.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", dropdown).CornerRadius = UDim.new(0, 5)

    local listFrame = Instance.new("Frame", frame)
    listFrame.Size = UDim2.new(1, -24, 0, #options * 26)
    listFrame.Position = UDim2.new(0, 12, 0, 60)
    listFrame.BackgroundColor3 = colors.button
    listFrame.BorderSizePixel = 0
    listFrame.ZIndex = 20
    listFrame.Visible = false
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 5)
    local lStroke = Instance.new("UIStroke", listFrame)
    lStroke.Color = colors.accent
    lStroke.Thickness = 1

    local expanded = false

    for i, opt in ipairs(options) do
        local item = Instance.new("TextButton", listFrame)
        item.Size = UDim2.new(1, 0, 0, 26)
        item.Position = UDim2.new(0, 0, 0, (i-1)*26)
        item.BackgroundTransparency = 1
        item.Text = "  " .. opt
        item.TextColor3 = colors.text
        item.TextSize = 12
        item.Font = Enum.Font.Gotham
        item.ZIndex = 21
        item.TextXAlignment = Enum.TextXAlignment.Left

        item.MouseEnter:Connect(function()
            item.BackgroundColor3 = colors.accent
            item.BackgroundTransparency = 0.7
        end)
        item.MouseLeave:Connect(function()
            item.BackgroundTransparency = 1
        end)
        item.MouseButton1Click:Connect(function()
            dropdown.Text = "  " .. opt .. "  ▾"
            expanded = false
            listFrame.Visible = false
            frame.Size = UDim2.new(1, -4, 0, 62)
            if callback then callback(opt) end
        end)
    end

    dropdown.MouseButton1Click:Connect(function()
        expanded = not expanded
        listFrame.Visible = expanded
        frame.Size = expanded and UDim2.new(1, -4, 0, 62 + #options * 26) or UDim2.new(1, -4, 0, 62)
    end)

    return frame
end

