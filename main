    label.Size = UDim2.new(1, -20, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = colors.subtext
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextWrapped = true
    label.Parent = parent
    return label
end

-- ==================== ULEPSZONE FUNKCJE AIMBOT ====================

-- FOV Circle rysowany jako BillboardGui na środku ekranu
local fovFrame = nil

local function createFOVFrame()
    if fovFrame then fovFrame:Destroy() end
    fovFrame = Instance.new("Frame")
    fovFrame.Name = "LiquidEz_FOVCircle"
    fovFrame.BackgroundTransparency = 1
    fovFrame.Size = UDim2.new(0, aimbotFOV * 2, 0, aimbotFOV * 2)
    fovFrame.Position = UDim2.new(0.5, -aimbotFOV, 0.5, -aimbotFOV)
    fovFrame.Parent = ScreenGui

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.2
    stroke.Transparency = 0.3
    stroke.Parent = fovFrame

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1, 0)
    uiCorner.Parent = fovFrame

    fovFrame.Visible = aimbotShowFOV and aimbotEnabled
end

local function updateFOVFrame()
    if not fovFrame then return end
    fovFrame.Size = UDim2.new(0, aimbotFOV * 2, 0, aimbotFOV * 2)
    fovFrame.Position = UDim2.new(0.5, -aimbotFOV, 0.5, -aimbotFOV)
    fovFrame.Visible = aimbotShowFOV and aimbotEnabled
end

-- Raycast visibility check (nowoczesne API)
local function isVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(origin, direction, raycastParams)
    if result then
        return result.Instance and result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

-- Znajdź najlepszy cel w FOV
local function getBestTarget()
    local closestTarget = nil
    local closestDist = aimbotFOV
    local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- Lock On: jeśli cel wciąż żywy - trzymaj go
    if aimbotLockOn and aimbotCurrentTarget then
        local char = aimbotCurrentTarget.Character
        if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local part = char:FindFirstChild(aimbotPart) or char:FindFirstChild("HumanoidRootPart")
            if part then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    return part, aimbotCurrentTarget
                end
            end
        else
            aimbotCurrentTarget = nil
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end

        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        -- Team check
        if aimbotTeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
            continue
        end

        local targetPart = player.Character:FindFirstChild(aimbotPart) or player.Character:FindFirstChild("HumanoidRootPart")
        if not targetPart then continue end

        -- Visibility check
        if aimbotVisibleCheck and not isVisible(targetPart) then continue end

        -- Dystans od środka ekranu
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        -- Max dystans 3D
        local worldDist = (targetPart.Position - Camera.CFrame.Position).Magnitude
        if worldDist > espMaxDistance then continue end

        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
        if screenDist < closestDist then
            closestDist = screenDist
            closestTarget = targetPart
            if aimbotLockOn then aimbotCurrentTarget = player end
        end
    end

    return closestTarget
end

local function updateAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end

    if not aimbotEnabled then
        if fovFrame then fovFrame.Visible = false end
        return
    end

    createFOVFrame()

    aimbotConnection = RunService.RenderStepped:Connect(function()
        if not aimbotEnabled then return end
        updateFOVFrame()

        -- Hold RMB check
        if aimbotHoldKey and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            return
        end

        local closestTarget = getBestTarget()
        if not closestTarget then return end

        local targetPos = closestTarget.Position

        -- Prediction: skalowane po dystansie
        if aimbotPrediction > 0 then
            local rootPart = closestTarget.Parent and closestTarget.Parent:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local velocity = rootPart.AssemblyLinearVelocity
                local dist = (targetPos - Camera.CFrame.Position).Magnitude
                local timeFactor = math.clamp(dist / 500, 0.05, 1)
                targetPos = targetPos + velocity * aimbotPrediction * timeFactor
            end
        end

        -- Smooth aim (dynamicznie: im bliżej centrum tym szybszy)
        local sp = Camera:WorldToViewportPoint(targetPos)
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        local dynamicSmooth = math.clamp(aimbotSmoothing + (screenDist / aimbotFOV) * 0.25, aimbotSmoothing, 0.98)

        local currentCF = Camera.CFrame
        local goalCF = CFrame.new(currentCF.Position, targetPos)
        Camera.CFrame = currentCF:Lerp(goalCF, 1 - dynamicSmooth)
    end)
end

-- ==================== ULEPSZONE FUNKCJE ESP ====================

local function removeESPForPlayer(player)
    if not espPlayerData[player] then return end
    local data = espPlayerData[player]
    if data.boxBillboard and data.boxBillboard.Parent then data.boxBillboard:Destroy() end
    if data.hpBillboard and data.hpBillboard.Parent then data.hpBillboard:Destroy() end
    if data.nameBillboard and data.nameBillboard.Parent then data.nameBillboard:Destroy() end
    if data.distBillboard and data.distBillboard.Parent then data.distBillboard:Destroy() end
    if data.weaponBillboard and data.weaponBillboard.Parent then data.weaponBillboard:Destroy() end
    if data.tracerLine and data.tracerLine.Parent then data.tracerLine:Destroy() end
    espPlayerData[player] = nil
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    removeESPForPlayer(player)

    local function addESP(character)
        task.wait(0.3)
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end

        local data = { player = player, character = character, rootPart = rootPart, humanoid = humanoid }

        -- === BOX (ramka wokół postaci) ===
        local boxBillboard = Instance.new("BillboardGui")
        boxBillboard.Name = "LiquidEz_Box"
        boxBillboard.Adornee = rootPart
        boxBillboard.Size = UDim2.new(0, 58, 0, 92)
        boxBillboard.AlwaysOnTop = true
        boxBillboard.Parent = character

        local boxFrame = Instance.new("Frame")
        boxFrame.Size = UDim2.new(1, 0, 1, 0)
        boxFrame.BackgroundTransparency = 1
        boxFrame.Parent = boxBillboard

        local boxStroke = Instance.new("UIStroke")
        boxStroke.Color = espColor
        boxStroke.Thickness = 1.5
        boxStroke.Parent = boxFrame

        data.boxBillboard = boxBillboard
        data.boxStroke = boxStroke

        -- === HEALTH BAR (pionowy pasek z lewej) ===
        local hpBillboard = Instance.new("BillboardGui")
        hpBillboard.Name = "LiquidEz_HP"
        hpBillboard.Adornee = rootPart
        hpBillboard.Size = UDim2.new(0, 7, 0, 92)
        hpBillboard.StudsOffsetWorldSpace = Vector3.new(-2.3, 0, 0)
        hpBillboard.AlwaysOnTop = true
        hpBillboard.Parent = character

        local hpBg = Instance.new("Frame")
        hpBg.Size = UDim2.new(1, 0, 1, 0)
        hpBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        hpBg.BorderSizePixel = 0
        hpBg.Parent = hpBillboard

        local hpCorner = Instance.new("UICorner")
        hpCorner.CornerRadius = UDim.new(0, 2)
        hpCorner.Parent = hpBg

        local hp = humanoid.Health / humanoid.MaxHealth

        local hpFill = Instance.new("Frame")
        hpFill.Name = "Fill"
        hpFill.Size = UDim2.new(1, 0, math.max(0.02, hp), 0)
        hpFill.AnchorPoint = Vector2.new(0, 1)
        hpFill.Position = UDim2.new(0, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.new(1 - hp, hp, 0)
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBg

        local hpFillCorner = Instance.new("UICorner")
        hpFillCorner.CornerRadius = UDim.new(0, 2)
        hpFillCorner.Parent = hpFill

        local hpText = Instance.new("TextLabel")
        hpText.Size = UDim2.new(3, 0, 0, 12)
        hpText.Position = UDim2.new(0, -3, 0, -14)
        hpText.BackgroundTransparency = 1
        hpText.Text = math.floor(humanoid.Health) .. " HP"
        hpText.TextColor3 = Color3.fromRGB(230, 230, 230)
        hpText.TextStrokeTransparency = 0.5
        hpText.Font = Enum.Font.GothamBold
        hpText.TextSize = 9
        hpText.Parent = hpBg

        data.hpBillboard = hpBillboard
        data.hpFill = hpFill
        data.hpText = hpText

        -- === NAME TAG (nad głową) ===
        local nameBillboard = Instance.new("BillboardGui")
        nameBillboard.Name = "LiquidEz_Name"
        nameBillboard.Adornee = rootPart
        nameBillboard.Size = UDim2.new(0, 140, 0, 20)
        nameBillboard.StudsOffset = Vector3.new(0, 3.7, 0)
        nameBillboard.AlwaysOnTop = true
        nameBillboard.Parent = character

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = espColor
        nameLabel.TextStrokeTransparency = 0.3
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 13
        nameLabel.Parent = nameBillboard

        data.nameBillboard = nameBillboard
        data.nameLabel = nameLabel

        -- === DYSTANS ===
        local distBillboard = Instance.new("BillboardGui")
        distBillboard.Name = "LiquidEz_Dist"
        distBillboard.Adornee = rootPart
        distBillboard.Size = UDim2.new(0, 80, 0, 14)
        distBillboard.StudsOffset = Vector3.new(0, 3.0, 0)
        distBillboard.AlwaysOnTop = true
        distBillboard.Parent = character

        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 1, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0m"
        distLabel.TextColor3 = Color3.fromRGB(190, 190, 190)
        distLabel.TextStrokeTransparency = 0.4
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 11
        distLabel.Parent = distBillboard

        data.distBillboard = distBillboard
        data.distLabel = distLabel

        -- === BROŃ (pod nogami) ===
        local weaponBillboard = Instance.new("BillboardGui")
        weaponBillboard.Name = "LiquidEz_Weapon"
        weaponBillboard.Adornee = rootPart
        weaponBillboard.Size = UDim2.new(0, 130, 0, 14)
        weaponBillboard.StudsOffset = Vector3.new(0, -4.2, 0)
        weaponBillboard.AlwaysOnTop = true
        weaponBillboard.Enabled = espShowWeapon
        weaponBillboard.Parent = character

        local weaponLabel = Instance.new("TextLabel")
        weaponLabel.Size = UDim2.new(1, 0, 1, 0)
        weaponLabel.BackgroundTransparency = 1
        weaponLabel.Text = "[no tool]"
        weaponLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
        weaponLabel.TextStrokeTransparency = 0.4
        weaponLabel.Font = Enum.Font.Gotham
        weaponLabel.TextSize = 11
        weaponLabel.Parent = weaponBillboard

        data.weaponBillboard = weaponBillboard
        data.weaponLabel = weaponLabel

        -- === TRACER (linia od dołu ekranu) jako BillboardGui + Frame ===
        -- (Drawing API nie jest dostępne w Roblox Studio, używamy innego podejścia)
        -- Tracer jest obsługiwany przez RenderStepped przez SurfaceGui na ziemi

        espPlayerData[player] = data
    end

    if player.Character then addESP(player.Character) end

    player.CharacterAdded:Connect(function(character)
        if espEnabled then addESP(character) end
    end)

    player.CharacterRemoving:Connect(function()
        -- Wyczyść stare dane gdy postać usunięta
        if espPlayerData[player] then
            local d = espPlayerData[player]
            d.rootPart = nil
            d.character = nil
        end
    end)
end

local function updateESP()
    if not espEnabled then return end

    for player, data in pairs(espPlayerData) do
        if not player or not player.Parent then
            removeESPForPlayer(player)
            continue
        end

        local character = player.Character
        if not character then continue end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        if not rootPart or not humanoid then continue end

        local dist = (rootPart.Position - Camera.CFrame.Position).Magnitude
        local inRange = dist <= espMaxDistance
        local alive = humanoid.Health > 0
        local show = inRange and alive

        -- Aktualizuj widoczność
        if data.boxBillboard then data.boxBillboard.Enabled = show and espShowBoxes end
        if data.hpBillboard then data.hpBillboard.Enabled = show and espShowHealth end
        if data.nameBillboard then data.nameBillboard.Enabled = show and espShowNames end
        if data.distBillboard then data.distBillboard.Enabled = show and espShowDistance end
        if data.weaponBillboard then data.weaponBillboard.Enabled = show and espShowWeapon end

        if not show then continue end

        -- Health bar aktualizacja
        local hp = humanoid.Health / humanoid.MaxHealth
        local hpColor = Color3.new(1 - hp, hp, 0)

        if data.hpFill then
            data.hpFill.Size = UDim2.new(1, 0, math.max(0.02, hp), 0)
            data.hpFill.BackgroundColor3 = hpColor
        end
        if data.hpText then
            data.hpText.Text = math.floor(humanoid.Health) .. " HP"
        end

        -- Nazwa + kolor
        if data.nameLabel then
            data.nameLabel.TextColor3 = espColor
            data.nameLabel.Text = player.Name
        end

        -- Box kolor
        if data.boxStroke then
            data.boxStroke.Color = espColor
        end

        -- Dystans
        if data.distLabel then
            data.distLabel.Text = math.floor(dist) .. "m"
        end

        -- Broń
        if data.weaponLabel and espShowWeapon then
            local tool = character:FindFirstChildOfClass("Tool")
            data.weaponLabel.Text = tool and ("[" .. tool.Name .. "]") or "[no tool]"
        end
    end
end

local function clearAllESP()
    for player, _ in pairs(espPlayerData) do
        removeESPForPlayer(player)
    end
    espPlayerData = {}
end

-- ==================== AUTO SHOOT ====================

local function updateAutoShoot()
    if autoShootConnection then autoShootConnection:Disconnect() end
    if not autoShootEnabled then return end

    autoShootConnection = RunService.Heartbeat:Connect(function()
        if not autoShootEnabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            local remote = tool:FindFirstChild("Remote") or tool:FindFirstChild("Activate") or tool:FindFirstChild("Shoot") or tool:FindFirstChild("Fire")
            if remote then
                if remote:IsA("RemoteEvent") then remote:FireServer()
                elseif remote:IsA("RemoteFunction") then pcall(function() remote:InvokeServer() end) end
            else
                tool:Activate()
            end
        end
    end)
end

-- ==================== SPEED ====================

local function updateSpeed()
    if speedConnection then speedConnection:Disconnect() end
    if not speedEnabled then return end

    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end

    originalSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = speedValue

    speedConnection = RunService.Heartbeat:Connect(function()
        if not speedEnabled then return end
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = speedValue
        end
    end)
end

-- ==================== FLY ====================

local function updateFly()
    if flyConnection then flyConnection:Disconnect() end
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end

    local stateList = {
        Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.GettingUp, Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.Landed, Enum.HumanoidStateType.Physics,
        Enum.HumanoidStateType.PlatformStanding, Enum.HumanoidStateType.Ragdoll,
        Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics,
        Enum.HumanoidStateType.StrafingNoPhysics
    }

    if not flyEnabled then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("Humanoid") then
            character.Humanoid.PlatformStand = false
            for _, state in ipairs(stateList) do character.Humanoid:SetStateEnabled(state, true) end
        end
        return
    end

    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local humanoid = character:FindFirstChild("Humanoid")

    if humanoid then
        humanoid.PlatformStand = true
        for _, state in ipairs(stateList) do humanoid:SetStateEnabled(state, false) end
    end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(10000, 10000, 10000)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = rootPart

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyEnabled or not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local dir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
        flyBodyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.new(0, 0, 0)
    end)
end

