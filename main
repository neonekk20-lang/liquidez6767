-- ==================== FOV CIRCLE ====================

local fovFrame = nil

local function createFOVFrame()
    if fovFrame then fovFrame:Destroy() end
    fovFrame = Instance.new("Frame", ScreenGui)
    fovFrame.BackgroundTransparency = 1
    fovFrame.Size = UDim2.new(0, aimbotFOV * 2, 0, aimbotFOV * 2)
    fovFrame.Position = UDim2.new(0.5, -aimbotFOV, 0.5, -aimbotFOV)

    local stroke = Instance.new("UIStroke", fovFrame)
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.2
    stroke.Transparency = 0.4

    Instance.new("UICorner", fovFrame).CornerRadius = UDim.new(1, 0)
    fovFrame.Visible = aimbotShowFOV and aimbotEnabled
end

local function updateFOVFrame()
    if not fovFrame then return end
    fovFrame.Size = UDim2.new(0, aimbotFOV * 2, 0, aimbotFOV * 2)
    fovFrame.Position = UDim2.new(0.5, -aimbotFOV, 0.5, -aimbotFOV)
    fovFrame.Visible = aimbotShowFOV and aimbotEnabled
end

-- ==================== AIMBOT ====================

local function isVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character or Instance.new("Model")}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, direction * 0.99, params)
    if result then
        return result.Instance and result.Instance:IsDescendantOf(targetPart.Parent.Parent or targetPart.Parent)
    end
    return true
end

local function getBestTarget()
    local closestTarget = nil
    local closestDist = aimbotFOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if aimbotLockOn and aimbotCurrentTarget then
        local char = aimbotCurrentTarget.Character
        if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local part = char:FindFirstChild(aimbotPart) or char:FindFirstChild("HumanoidRootPart")
            if part then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then return part end
            end
        else
            aimbotCurrentTarget = nil
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        if aimbotTeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end

        local targetPart = player.Character:FindFirstChild(aimbotPart) or player.Character:FindFirstChild("HumanoidRootPart")
        if not targetPart then continue end
        if aimbotVisibleCheck and not isVisible(targetPart) then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        local worldDist = (targetPart.Position - Camera.CFrame.Position).Magnitude
        if worldDist > espMaxDistance then continue end

        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if screenDist < closestDist then
            closestDist = screenDist
            closestTarget = targetPart
            if aimbotLockOn then aimbotCurrentTarget = player end
        end
    end

    return closestTarget
end

local function updateAimbot()
    if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
    if not aimbotEnabled then
        if fovFrame then fovFrame.Visible = false end
        return
    end
    createFOVFrame()

    aimbotConnection = RunService.RenderStepped:Connect(function()
        if not aimbotEnabled then return end
        updateFOVFrame()

        if aimbotHoldKey and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

        local target = getBestTarget()
        if not target then return end

        local targetPos = target.Position

        -- Bullet prediction
        if aimbotPrediction > 0 then
            local root = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
            if root then
                local vel = root.AssemblyLinearVelocity
                local dist = (targetPos - Camera.CFrame.Position).Magnitude
                local timeFactor = math.clamp(dist / 400, 0.05, 1)
                targetPos = targetPos + vel * aimbotPrediction * timeFactor
            end
        end

        local sp = Camera:WorldToViewportPoint(targetPos)
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        local dynamicSmooth = math.clamp(aimbotSmoothing + (screenDist / math.max(aimbotFOV, 1)) * 0.2, aimbotSmoothing, 0.97)

        local currentCF = Camera.CFrame
        local goalCF = CFrame.new(currentCF.Position, targetPos)
        Camera.CFrame = currentCF:Lerp(goalCF, 1 - dynamicSmooth)
    end)
end

-- ==================== ESP ====================

local function removeESPForPlayer(player)
    if not espPlayerData[player] then return end
    local data = espPlayerData[player]
    for _, key in pairs({"boxBillboard","hpBillboard","nameBillboard","distBillboard","weaponBillboard"}) do
        if data[key] and data[key].Parent then data[key]:Destroy() end
    end
    espPlayerData[player] = nil
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    removeESPForPlayer(player)

    local function addESP(character)
        task.wait(0.4)
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end

        local data = {player=player, character=character, rootPart=rootPart, humanoid=humanoid}

        -- BOX
        local boxBB = Instance.new("BillboardGui", character)
        boxBB.Name = "LiquidEz_Box"
        boxBB.Adornee = rootPart
        boxBB.Size = UDim2.new(0, 60, 0, 96)
        boxBB.AlwaysOnTop = true

        local boxFrame = Instance.new("Frame", boxBB)
        boxFrame.Size = UDim2.new(1, 0, 1, 0)
        boxFrame.BackgroundTransparency = 1

        local boxStroke = Instance.new("UIStroke", boxFrame)
        boxStroke.Color = espColor
        boxStroke.Thickness = 1.5

        data.boxBillboard = boxBB
        data.boxStroke = boxStroke

        -- HEALTH BAR (left side)
        local hpBB = Instance.new("BillboardGui", character)
        hpBB.Name = "LiquidEz_HP"
        hpBB.Adornee = rootPart
        hpBB.Size = UDim2.new(0, 6, 0, 96)
        hpBB.StudsOffsetWorldSpace = Vector3.new(-2.5, 0, 0)
        hpBB.AlwaysOnTop = true

        local hpBg = Instance.new("Frame", hpBB)
        hpBg.Size = UDim2.new(1, 0, 1, 0)
        hpBg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        hpBg.BorderSizePixel = 0
        Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 2)

        local hp = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)

        local hpFill = Instance.new("Frame", hpBg)
        hpFill.Size = UDim2.new(1, 0, math.max(0.02, hp), 0)
        hpFill.AnchorPoint = Vector2.new(0, 1)
        hpFill.Position = UDim2.new(0, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.new(1 - hp, hp * 0.9, 0)
        hpFill.BorderSizePixel = 0
        Instance.new("UICorner", hpFill).CornerRadius = UDim.new(0, 2)

        local hpText = Instance.new("TextLabel", hpBg)
        hpText.Size = UDim2.new(4, 0, 0, 10)
        hpText.Position = UDim2.new(0, -3, 0, -12)
        hpText.BackgroundTransparency = 1
        hpText.Text = math.floor(humanoid.Health) .. "hp"
        hpText.TextColor3 = Color3.fromRGB(220, 220, 220)
        hpText.TextStrokeTransparency = 0.5
        hpText.Font = Enum.Font.GothamBold
        hpText.TextSize = 8

        data.hpBillboard = hpBB
        data.hpFill = hpFill
        data.hpText = hpText

        -- NAME TAG
        local nameBB = Instance.new("BillboardGui", character)
        nameBB.Name = "LiquidEz_Name"
        nameBB.Adornee = rootPart
        nameBB.Size = UDim2.new(0, 150, 0, 20)
        nameBB.StudsOffset = Vector3.new(0, 3.8, 0)
        nameBB.AlwaysOnTop = true

        local nameLabel = Instance.new("TextLabel", nameBB)
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = espColor
        nameLabel.TextStrokeTransparency = 0.2
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 13

        data.nameBillboard = nameBB
        data.nameLabel = nameLabel

        -- DISTANCE
        local distBB = Instance.new("BillboardGui", character)
        distBB.Name = "LiquidEz_Dist"
        distBB.Adornee = rootPart
        distBB.Size = UDim2.new(0, 90, 0, 14)
        distBB.StudsOffset = Vector3.new(0, 2.8, 0)
        distBB.AlwaysOnTop = true

        local distLabel = Instance.new("TextLabel", distBB)
        distLabel.Size = UDim2.new(1, 0, 1, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0m"
        distLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        distLabel.TextStrokeTransparency = 0.4
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 11

        data.distBillboard = distBB
        data.distLabel = distLabel

        -- WEAPON
        local weapBB = Instance.new("BillboardGui", character)
        weapBB.Name = "LiquidEz_Weapon"
        weapBB.Adornee = rootPart
        weapBB.Size = UDim2.new(0, 140, 0, 14)
        weapBB.StudsOffset = Vector3.new(0, -4.5, 0)
        weapBB.AlwaysOnTop = true
        weapBB.Enabled = espShowWeapon

        local weapLabel = Instance.new("TextLabel", weapBB)
        weapLabel.Size = UDim2.new(1, 0, 1, 0)
        weapLabel.BackgroundTransparency = 1
        weapLabel.Text = "[no tool]"
        weapLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
        weapLabel.TextStrokeTransparency = 0.4
        weapLabel.Font = Enum.Font.Gotham
        weapLabel.TextSize = 11

        data.weaponBillboard = weapBB
        data.weaponLabel = weapLabel

        espPlayerData[player] = data
    end

    if player.Character then addESP(player.Character) end
    player.CharacterAdded:Connect(function(char)
        if espEnabled then addESP(char) end
    end)
    player.CharacterRemoving:Connect(function()
        if espPlayerData[player] then
            espPlayerData[player].rootPart = nil
            espPlayerData[player].character = nil
        end
    end)
end

local function updateESP()
    if not espEnabled then return end
    for player, data in pairs(espPlayerData) do
        if not player or not player.Parent then removeESPForPlayer(player) continue end
        local character = player.Character
        if not character then continue end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        if not rootPart or not humanoid then continue end

        local dist = (rootPart.Position - Camera.CFrame.Position).Magnitude
        local alive = humanoid.Health > 0
        local show = dist <= espMaxDistance and alive

        if data.boxBillboard then data.boxBillboard.Enabled = show and espShowBoxes end
        if data.hpBillboard then data.hpBillboard.Enabled = show and espShowHealth end
        if data.nameBillboard then data.nameBillboard.Enabled = show and espShowNames end
        if data.distBillboard then data.distBillboard.Enabled = show and espShowDistance end
        if data.weaponBillboard then data.weaponBillboard.Enabled = show and espShowWeapon end

        if not show then continue end

        local hp = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        if data.hpFill then
            data.hpFill.Size = UDim2.new(1, 0, math.max(0.02, hp), 0)
            data.hpFill.BackgroundColor3 = Color3.new(1 - hp, hp * 0.9, 0)
        end
        if data.hpText then data.hpText.Text = math.floor(humanoid.Health) .. "hp" end
        if data.nameLabel then data.nameLabel.TextColor3 = espColor end
        if data.boxStroke then data.boxStroke.Color = espColor end
        if data.distLabel then data.distLabel.Text = math.floor(dist) .. "m" end
        if data.weaponLabel and espShowWeapon then
            local tool = character:FindFirstChildOfClass("Tool")
            data.weaponLabel.Text = tool and ("[" .. tool.Name .. "]") or "[no tool]"
        end
    end
end

local function clearAllESP()
    for player in pairs(espPlayerData) do removeESPForPlayer(player) end
    espPlayerData = {}
end

-- ==================== AUTO SHOOT ====================

local function updateAutoShoot()
    if autoShootConnection then autoShootConnection:Disconnect() end
    if not autoShootEnabled then return end
    autoShootConnection = RunService.Heartbeat:Connect(function()
        if not autoShootEnabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            local remote = tool:FindFirstChild("Remote") or tool:FindFirstChild("Shoot") or tool:FindFirstChild("Fire")
            if remote then
                pcall(function()
                    if remote:IsA("RemoteEvent") then remote:FireServer()
                    elseif remote:IsA("RemoteFunction") then remote:InvokeServer() end
                end)
            else
                pcall(function() tool:Activate() end)
            end
        end
        task.wait(math.max(0.05, autoShootDelay))
    end)
end

-- ==================== SPEED HACK (FIXED) ====================

local function setSpeed(value)
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then humanoid.WalkSpeed = value end
end

local function updateSpeed()
    if speedConnection then speedConnection:Disconnect(); speedConnection = nil end
    if not speedEnabled then
        setSpeed(originalSpeed)
        return
    end
    setSpeed(speedValue)
    speedConnection = RunService.Heartbeat:Connect(function()
        if not speedEnabled then return end
        local char = LocalPlayer.Character
        if char then
            local h = char:FindFirstChild("Humanoid")
            if h and h.WalkSpeed ~= speedValue then h.WalkSpeed = speedValue end
        end
    end)
end

-- ==================== JUMP HACK (FIXED) ====================

local function setJump(value)
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end

    if humanoid.UseJumpPower then
        humanoid.JumpPower = value
    else
        local g = workspace.Gravity
        humanoid.JumpHeight = (value * value) / (2 * g)
    end
end

local function updateJump()
    if jumpConnection then jumpConnection:Disconnect(); jumpConnection = nil end
    if not jumpEnabled then
        setJump(originalJumpPower)
        return
    end
    setJump(jumpValue)
    jumpConnection = RunService.Heartbeat:Connect(function()
        if not jumpEnabled then return end
        local char = LocalPlayer.Character
        if char then
            local h = char:FindFirstChild("Humanoid")
            if h and h.UseJumpPower and h.JumpPower ~= jumpValue then
                h.JumpPower = jumpValue
            end
        end
    end)
end

-- ==================== FLY HACK (IMPROVED + BodyGyro) ====================

local function updateFly()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end

    if not flyEnabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.PlatformStand = false end
        end
        return
    end

    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then humanoid.PlatformStand = true end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = rootPart

    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyGyro.P = 10000
    flyGyro.CFrame = Camera.CFrame
    flyGyro.Parent = rootPart

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyEnabled then return end
        if not character or not character.Parent then return end
        local rp = character:FindFirstChild("HumanoidRootPart")
        if not rp or not flyBodyVelocity or not flyBodyVelocity.Parent then return end

        local dir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end

        flyBodyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.new(0, 0, 0)
        flyGyro.CFrame = Camera.CFrame
    end)
end

-- ==================== NOCLIP ====================

local function updateNoclip()
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if not noclipEnabled then
        local character = LocalPlayer.Character
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
        return
    end
    noclipConnection = RunService.Stepped:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
end

