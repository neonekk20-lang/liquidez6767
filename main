-- ==================== VISUALS TAB ====================
local visualsContainer = tabContents["Visuals"]

createSection(visualsContainer, "ESP Settings")

createToggle(visualsContainer, "ESP", false, function(state)
    espEnabled = state
    
    if espEnabled then
        -- Clear existing ESP
        for _, v in ipairs(espBoxes) do if v then v:Destroy() end end
        for _, v in ipairs(espNames) do if v then v:Destroy() end end
        for _, v in ipairs(espHealthBars) do if v then v:Destroy() end end
        for _, v in ipairs(espDistance) do if v.billboard then v.billboard:Destroy() end end
        
        espBoxes = {}
        espNames = {}
        espHealthBars = {}
        espDistance = {}
        
        -- Create ESP for all players
        for _, player in pairs(Players:GetPlayers()) do
            createESPForPlayer(player)
        end
        
        -- Connect for new players
        Players.PlayerAdded:Connect(function(player)
            if espEnabled then
                createESPForPlayer(player)
            end
        end)
    else
        -- Remove all ESP
        for _, v in ipairs(espBoxes) do if v then v:Destroy() end end
        for _, v in ipairs(espNames) do if v then v:Destroy() end end
        for _, v in ipairs(espHealthBars) do if v then v:Destroy() end end
        for _, v in ipairs(espDistance) do if v.billboard then v.billboard:Destroy() end end
        
        espBoxes = {}
        espNames = {}
        espHealthBars = {}
        espDistance = {}
    end
end)

createDropdown(visualsContainer, "ESP Color", {"Red", "Blue", "Green", "Yellow", "Purple"}, "Red", function(option)
    if option == "Red" then
        espColor = Color3.fromRGB(255, 50, 50)
    elseif option == "Blue" then
        espColor = Color3.fromRGB(50, 50, 255)
    elseif option == "Green" then
        espColor = Color3.fromRGB(50, 255, 50)
    elseif option == "Yellow" then
        espColor = Color3.fromRGB(255, 255, 50)
    elseif option == "Purple" then
        espColor = Color3.fromRGB(255, 50, 255)
    end
    
    -- Update existing ESP
    for _, box in ipairs(espBoxes) do
        if box then box.Color3 = espColor end
    end
    
    for _, name in ipairs(espNames) do
        if name and name:FindFirstChildOfClass("TextLabel") then
            name:FindFirstChildOfClass("TextLabel").TextColor3 = espColor
        end
    end
end)

createLabel(visualsContainer, "ESP shows player boxes, names, health bars, and distance")

