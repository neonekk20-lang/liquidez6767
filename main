-- ==================== FUNCTIONS ====================

-- Update tab visibility
function updateTabVisibility()
    for tabName, container in pairs(tabContents) do
        container.Visible = (tabName == currentTab)
    end
end

-- Notification function
function notify(message, duration)
    local notification = Instance.new("Frame")
    notification.Size = UDim2.new(0, 300, 0, 50)
    notification.Position = UDim2.new(0.5, -150, 0, 10)
    notification.BackgroundColor3 = colors.topbar
    notification.BackgroundTransparency = 0
    notification.Parent = ScreenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notification
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -20, 1, 0)
    text.Position = UDim2.new(0, 10, 0, 0)
    text.BackgroundTransparency = 1
    text.Text = message
    text.TextColor3 = colors.text
    text.TextWrapped = true
    text.Font = Enum.Font.Gotham
    text.TextSize = 14
    text.Parent = notification
    
    TweenService:Create(notification, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
    
    wait(duration or 3)
    
    TweenService:Create(notification, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    wait(0.5)
    notification:Destroy()
end

-- ==================== DRAG FUNCTIONALITY ====================

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==================== BUTTON FUNCTIONALITY ====================

CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

MinimizeButton.MouseButton1Click:Connect(function()
    guiVisible = false
    MainFrame.Visible = false
end)

-- Keybind to toggle GUI
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
        guiVisible = not guiVisible
        MainFrame.Visible = guiVisible
    end
    
    -- Quick toggle keybinds
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.G then
            aimbotEnabled = not aimbotEnabled
            updateAimbot()
            notify("Aimbot " .. (aimbotEnabled and "Enabled" or "Disabled"), 1)
        elseif input.KeyCode == Enum.KeyCode.H then
            speedEnabled = not speedEnabled
            updateSpeed()
            notify("Speed " .. (speedEnabled and "Enabled" or "Disabled"), 1)
        elseif input.KeyCode == Enum.KeyCode.J then
            flyEnabled = not flyEnabled
            updateFly()
            notify("Fly " .. (flyEnabled and "Enabled" or "Disabled"), 1)
        end
    end
end)

-- Update ESP continuously
RunService.RenderStepped:Connect(function()
    if espEnabled then
        updateESP()
    end
end)

-- Handle character respawn
LocalPlayer.CharacterAdded:Connect(function(character)
    -- Re-enable features on respawn
    if speedEnabled then
        wait(0.5)
        updateSpeed()
    end
    
    if flyEnabled then
        wait(0.5)
        updateFly()
    end
end)

-- Handle character removal
LocalPlayer.CharacterRemoving:Connect(function()
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
end)

-- Show initial tab
updateTabVisibility()

-- Welcome notifications
notify("LiquidEz Loaded! Press RightShift to toggle", 3)
wait(1)
notify("⚠️ WARNING: Using these features may result in account termination!", 5)
