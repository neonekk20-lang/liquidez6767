}, "Red", function(option)
    local colorMap = {
        Red = Color3.fromRGB(255, 50, 50),
        Blue = Color3.fromRGB(50, 120, 255),
        Green = Color3.fromRGB(50, 255, 50),
        Yellow = Color3.fromRGB(255, 255, 50),
        Purple = Color3.fromRGB(200, 50, 255),
        White = Color3.fromRGB(255, 255, 255),
        Cyan = Color3.fromRGB(0, 220, 255),
        Orange = Color3.fromRGB(255, 140, 0),
    }
    espColor = colorMap[option] or espColor

    for _, data in pairs(espPlayerData) do
        if data.boxStroke then data.boxStroke.Color = espColor end
        if data.nameLabel then data.nameLabel.TextColor3 = espColor end
    end
end)

